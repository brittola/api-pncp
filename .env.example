MONGO_URI=url_de_conexao_do_mongodb
# Mínimo de 32 caracteres (validado no boot). Gere com: openssl rand -hex 32
JWT_SECRET=segredo_do_jwt_com_no_minimo_32_caracteres
PORT=3000
# Ambiente: development | production
NODE_ENV=development
# Origens permitidas no CORS, separadas por vírgula (obrigatório em produção)
CORS_ORIGINS=http://localhost:5173,https://app.exemplo.com
